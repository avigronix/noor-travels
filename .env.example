# Copy to .env and fill in. Never commit .env.

# dev | prod  (prod: secure cookie, no /docs)
APP_ENV=dev
HOST=127.0.0.1
# 8020 is already used on the VPS – keep this different
PORT=8030
WORKERS=2

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

DATABASE_URL=postgresql://noor:noor_password@127.0.0.1:5432/noor_travels
DB_POOL_MIN=1
DB_POOL_MAX=10

# Office WhatsApp number used on the website buttons (with 91, no +)
OFFICE_WHATSAPP=919984414350

# Where the visa photo / profile photo files are saved (outside static/)
UPLOAD_DIR=uploads

# Website details – leave empty until the office confirms them (shown as [placeholders])
SITE_URL=
OFFICE_EMAIL=
OFFICE_HOURS=
OFFICE_GSTIN=
OFFICE_RA_LICENCE=
