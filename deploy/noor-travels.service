# /etc/systemd/system/noor-travels.service
# Runs the app with the server's system Python 3.10 venv. Separate service – nothing else on the VPS is touched.
[Unit]
Description=Noor Travels Services – staff software + website
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=noor
Group=noor
WorkingDirectory=/var/www/noor-travels
EnvironmentFile=/var/www/noor-travels/.env
ExecStart=/var/www/noor-travels/.venv/bin/python main.py
Restart=always
RestartSec=3
# light hardening – the app only needs its own folder and the uploads dir
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/noor-travels/uploads

[Install]
WantedBy=multi-user.target
